{
  "name": "system-definition-pg",
  "description": "Generates PostgreSQL database creation scripts from system-definition descriptions",
  "version": "0.3.0",
  "license": "MIT",
  "repository": "ari-dc-uba-ar/system-definition-pg",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && mocha --exit --node-option enable-source-maps dist/test/",
    "coverage": "tsc && c8 mocha --exit --node-option enable-source-maps dist/test/",
    "test-ci": "npm run coverage",
    "generate-baseline": "tsc && node dist/examples/aida/generate-baseline.js"
  },
  "dependencies": {
    "system-definition": "^0.3.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.1",
    "c8": "^12.0.0",
    "mocha": "^12.0.2",
    "qa-control": "^0.11.3",
    "typescript": "^7.0.2"
  },
  "qa-control": {
    "run-in": "server",
    "type": "lib",
    "gha": "all",
    "fileNameMainDoc": "README.md",
    "multilang": "no"
  }
}
